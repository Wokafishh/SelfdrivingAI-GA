        roughness 1
        metalness 0
      }
      geometry DEF OBSTACLE_5_BOX Box {
        size 0.12 0.12 0.2
      }
    }
  ]
  name "obstacle 5"
  boundingObject USE OBSTACLE_5_BOX
}
DEF OBSTACLE_6 Solid {
  translation -1.0 0.5 0.150
  rotation 0 0 1 1.4
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.3 0.32 0.35
        roughness 1
        metalness 0
      }
      geometry DEF OBSTACLE_6_BOX Box {
        size 0.18 0.18 0.3
      }
    }
  ]
  name "obstacle 6"
  boundingObject USE OBSTACLE_6_BOX
}
DEF OBSTACLE_7 Solid {
  translation -0.2 0.55 0.125
  rotation 0 0 1 0.9
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.85 0.82
        roughness 1
        metalness 0
      }
      geometry DEF OBSTACLE_7_BOX Box {
        size 0.15 0.15 0.25
      }
    }
  ]
  name "obstacle 7"
  boundingObject USE OBSTACLE_7_BOX
}
DEF OBSTACLE_8 Solid {
  translation 0.6 0.8 0.115
  rotation 0 0 1 2.6
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.55 0.42 0.28
        roughness 1
        metalness 0
      }
      geometry DEF OBSTACLE_8_BOX Box {
        size 0.14 0.14 0.23
      }
    }
  ]
  name "obstacle 8"
  boundingObject USE OBSTACLE_8_BOX
}
DEF OBSTACLE_9 Solid {
  translation -0.55 1.05 0.135
  rotation 0 0 1 0.2
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.35 0.6
        roughness 1
        metalness 0
      }
      geometry DEF OBSTACLE_9_BOX Box {
        size 0.16 0.16 0.27
      }
    }
  ]
  name "obstacle 9"
  boundingObject USE OBSTACLE_9_BOX
}
DEF CAR Robot {
  translation 0.1 -0.55 0
  rotation -0.043108 0.043108 0.99814 1.572662
  children [
    CadShape {
      url [
        "../../../Train_RL/models/webots/car_body.obj"
      ]
    }
    # ESP32-CAM lens: 2 cm under the top of the mast, 1 cm in front of it. Fixed to the body,
    # so it points slightly down like the real car (the caster is ~1 cm shorter than the wheels)
    Camera {
      translation 0.11 0 0.127
      name "camera"
      fieldOfView 1.0
      width 64
      height 64
      near 0.01
      noise 0.02
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 0.067 0.0325
      }
      device [
        RotationalMotor {
          name "left wheel motor"
          maxVelocity 15
          maxTorque 0.1
        }
      ]
      endPoint Solid {
        translation 0 0.067 0.0325
        children [
          CadShape {
            url [
              "../../../Train_RL/models/webots/car_wheel_left.obj"
            ]
          }
        ]
        name "left wheel"
        boundingObject DEF WHEEL_BOUNDS Pose {
          rotation 1 0 0 1.5708
          children [
            Cylinder {
              height 0.026
              radius 0.0325
            }
          ]
        }
        physics DEF WHEEL_PHYSICS Physics {
          density -1
          mass 0.03
        }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 -0.067 0.0325
      }
      device [
        RotationalMotor {
          name "right wheel motor"
          maxVelocity 15
          maxTorque 0.1
        }
      ]
      endPoint Solid {
        translation 0 -0.067 0.0325
        children [
          CadShape {
            url [
              "../../../Train_RL/models/webots/car_wheel_right.obj"
            ]
          }
        ]
        name "right wheel"
        boundingObject USE WHEEL_BOUNDS
        physics USE WHEEL_PHYSICS
      }
    }
    Solid {
      translation 0.104 0 0.018
      name "caster"
      contactMaterial "caster"
      boundingObject Sphere {
        radius 0.009
      }
      physics Physics {
        density -1
        mass 0.005
      }
    }
  ]
  name "rl_car"
  boundingObject Group {
    children [
      Pose {
        translation 0.056 0 0.0385
        children [
          Box {
            size 0.19 0.1 0.033
          }
        ]
      }
      Pose {
        translation 0.0925 0 0.0455
        children [
          Box {
            size 0.117 0.164 0.01
          }
        ]
      }
      Pose {
        translation 0.09 0 0.097
        children [
          Box {
            size 0.02 0.04 0.1
          }
        ]
      }
    ]
  }
  physics Physics {
    density -1
    mass 0.4
    centerOfMass [
      0.03 0 0.04
    ]
  }
  controller "rl_trainer"
  supervisor TRUE
}
