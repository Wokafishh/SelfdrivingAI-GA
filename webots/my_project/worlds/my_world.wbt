#VRML_SIM R2025a utf8
# Arena for RL training: 2.78 x 2.78 m floor, 0.68 m walls, 10 obstacles and a red goal cube.
# Car, goal and obstacles are re-randomized by the rl_trainer controller (Train_RL/webots_env.py)
# on every episode reset, so the positions below are only the starting layout.
# Arena center is the world origin. Texture/mesh paths are relative to this file.

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"

WorldInfo {
  info [
    "Self-driving car RL arena"
  ]
  basicTimeStep 16
  contactProperties [
    ContactProperties {
      material2 "caster"
      coulombFriction [
        0
      ]
    }
  ]
}
Viewpoint {
  orientation 0 1 0 0.9
  position -2.6 0 3.2
}
TexturedBackground {
  texture "empty_office"
}
TexturedBackgroundLight {
  texture "empty_office"
}
DEF FLOOR Solid {
  translation 0 0 -0.01
  children [
    Shape {
      appearance PBRAppearance {
        baseColorMap ImageTexture {
          url [
            "../../../Train_RL/textures/floor.jpg"
          ]
        }
        roughness 0.8
        metalness 0
        textureTransform TextureTransform {
          scale 4 7
        }
      }
      geometry DEF FLOOR_BOX Box {
        size 2.82 2.82 0.02
      }
    }
  ]
  name "floor"
  boundingObject USE FLOOR_BOX
  locked TRUE
}
DEF WALL_NORTH Solid {
  translation 0 1.4 0.34
  children [
    DEF WALL_X Shape {
      appearance DEF WALL_APPEARANCE PBRAppearance {
        baseColorMap ImageTexture {
          url [
            "../../../Train_RL/textures/walls.jpg"
          ]
        }
        roughness 0.9
        metalness 0
        textureTransform TextureTransform {
          scale 4 1.7
        }
      }
      geometry DEF WALL_X_BOX Box {
        size 2.82 0.02 0.68
      }
    }
  ]
  name "wall north"
  boundingObject USE WALL_X_BOX
  locked TRUE
}
DEF WALL_SOUTH Solid {
  translation 0 -1.4 0.34
  children [
    USE WALL_X
  ]
  name "wall south"
  boundingObject USE WALL_X_BOX
  locked TRUE
}
DEF WALL_EAST Solid {
  translation 1.4 0 0.34
  children [
    DEF WALL_Y Shape {
      appearance USE WALL_APPEARANCE
      geometry DEF WALL_Y_BOX Box {
        size 0.02 2.82 0.68
      }
    }
  ]
  name "wall east"
  boundingObject USE WALL_Y_BOX
  locked TRUE
}
DEF WALL_WEST Solid {
  translation -1.4 0 0.34
  children [
    USE WALL_Y
  ]
  name "wall west"
  boundingObject USE WALL_Y_BOX
  locked TRUE
}
DEF GOAL Solid {
  translation 0 1.1 0.04
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.05 0.05
        roughness 0.7
        metalness 0
      }
      geometry DEF GOAL_BOX Box {
        size 0.06 0.06 0.08
      }
    }
  ]
  name "goal"
  boundingObject USE GOAL_BOX
}
DEF OBSTACLE_0 Solid {
  translation -0.9 -0.9 0.125
  rotation 0 0 1 0.3
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.85 0.82
        roughness 1
        metalness 0
      }
      geometry DEF OBSTACLE_0_BOX Box {
        size 0.15 0.15 0.25
      }
    }
  ]
  name "obstacle 0"
  boundingObject USE OBSTACLE_0_BOX
}
